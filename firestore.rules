rules_version = '2';

/**
 * =============================================================================
 * DRIIVA FIRESTORE SECURITY RULES (Production)
 * =============================================================================
 *
 * Context:
 *   - Firebase Auth: users sign up with email/password (auth.uid = user id).
 *   - Collections: users, trips, driver_stats, policies, communityPool,
 *     poolShares, leaderboard, tripPoints, tripSegments.
 *
 * Principles:
 *   1. Users can only read/write their own data (users, trips, policies).
 *   2. Aggregated/computed data (driver_stats, communityPool, leaderboard,
 *      poolShares, tripSegments) are read-only for clients; only Cloud
 *      Functions (Firebase Admin SDK) can write them.
 *   3. Community pool and leaderboard are readable by everyone (including
 *      unauthenticated for public docs if desired).
 *   4. Cloud Functions use the Admin SDK and bypass these rules for writes.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    /** True if the request has a signed-in user. */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** True if the authenticated user owns the resource (document id or field). */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /** True if the given field is not being changed (for immutable fields). */
    function unchanged(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    /**
     * True if the trip status transition is a valid client-side transition.
     * Only these transitions are allowed from the client:
     *   recording  → processing  (client signals trip ended, ready for scoring)
     *   recording  → failed      (client aborts a trip, e.g. too short)
     * All other transitions (→ completed, → disputed, etc.) must come from
     * Cloud Functions via the Admin SDK (which bypasses these rules).
     */
    function isValidClientStatusTransition() {
      let current = resource.data.status;
      let next = request.resource.data.status;
      return (current == 'recording' && next == 'processing')
          || (current == 'recording' && next == 'failed');
    }

    // =========================================================================
    // USERNAMES COLLECTION (username → uid lookup for sign-in)
    // =========================================================================
    // Public read so sign-in page can resolve "johndoe" → uid.
    // Only the owning user can create/update their username doc.
    // NOTE: consider replacing public read with a Cloud Function to prevent
    // username enumeration attacks.

    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // =========================================================================
    // USERS COLLECTION
    // =========================================================================

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;

      allow update: if isOwner(userId)
        && unchanged('uid')
        && unchanged('createdAt')
        && unchanged('createdBy')
        && unchanged('drivingProfile')
        && unchanged('poolShare')
        && unchanged('recentTrips')
        && unchanged('activePolicy');

      allow delete: if false;

      // Beta pricing estimate (computed by Cloud Functions; client read-only)
      match /betaPricing/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // User achievements (unlocked by Cloud Functions; client read-only)
      match /achievements/{achId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Pending Stripe payments (written by webhook handler via Admin SDK; client read-only)
      // Explicit deny on write prevents a client from crafting a fake payment doc
      // that could trigger the Cloud Function to bind a Root policy without real payment.
      match /pendingPayments/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // =========================================================================
    // ACHIEVEMENTS COLLECTION (badge-definition catalogue)
    // =========================================================================
    // Static catalogue of achievement/badge definitions, seeded by the Admin SDK.
    // Distinct from /users/{userId}/achievements/{achId} above, which holds a
    // given user's UNLOCKED badges.

    match /achievements/{achId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // =========================================================================
    // TRIPS COLLECTION
    // =========================================================================

    match /trips/{tripId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.status == 'recording'
            || request.resource.data.status == 'processing');

      // Client may ONLY advance status via valid transitions (recording→processing
      // or recording→failed). Score, scoreBreakdown, events, anomalies, context
      // are locked; Cloud Functions set these via Admin SDK.
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && unchanged('score')
        && unchanged('scoreBreakdown')
        && unchanged('events')
        && unchanged('anomalies')
        && unchanged('context')
        && unchanged('userId')
        && unchanged('createdBy')
        && unchanged('createdAt')
        && isValidClientStatusTransition();

      allow delete: if false;
    }

    // =========================================================================
    // TRIP POINTS COLLECTION
    // =========================================================================

    match /tripPoints/{tripId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;

      match /batches/{batchId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/tripPoints/$(tripId)).data.userId == request.auth.uid;
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/tripPoints/$(tripId)).data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // DRIVER_STATS COLLECTION
    // =========================================================================

    match /driver_stats/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // =========================================================================
    // POLICIES COLLECTION
    // =========================================================================

    match /policies/{policyId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // COMMUNITY POOL COLLECTION
    // =========================================================================
    // Read-only for all users. Ensure no per-user financial data is stored
    // directly on pool documents (pool-level aggregates only).

    match /communityPool/{poolId} {
      allow read: if true;
      allow write: if false;

      // Wave B: closed periods, archived by finalizePoolPeriod before the
      // live document rolls forward. Aggregate figures only, no per-user
      // data, so it inherits the parent's public read. Written by the
      // scheduled function via the Admin SDK, never by a client.
      match /history/{period} {
        allow read: if true;
        allow write: if false;
      }
    }

    // =========================================================================
    // POOL SHARES COLLECTION
    // =========================================================================

    match /poolShares/{shareId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // =========================================================================
    // LEADERBOARD COLLECTION
    // =========================================================================

    // Leaderboard contains displayName + photoURL; restrict to authenticated users (GDPR).
    // Unauthenticated public read was previously allowed but publishes real user names/photos.
    match /leaderboard/{leaderboardId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // =========================================================================
    // FRIENDSHIPS COLLECTION (Wave B)
    // =========================================================================
    // One document per pair, id = the two uids sorted and joined by "_".
    // Deriving the id from the pair is what stops A and B holding two
    // mirrored rows that can disagree about whether they are friends.
    //
    // A friendship is created by the ACCEPTING user, as the second half of
    // redeeming an invite. The rules below cannot see the invite document, so
    // they enforce the parts that are checkable here: you may only create a
    // friendship you are part of, the id must match the sorted pair, and you
    // cannot make yourself a friend of yourself. Whether a valid unexpired
    // invite existed is enforced on the invite document itself, which the same
    // client must mark accepted.

    match /friendships/{friendshipId} {
      /** Both uids present, sorted, and matching the document id. */
      function wellFormedPair(data) {
        return data.users.size() == 2
            && data.users[0] < data.users[1]
            && friendshipId == data.users[0] + '_' + data.users[1]
            && data.friendshipId == friendshipId;
      }

      allow read: if isAuthenticated() && request.auth.uid in resource.data.users;

      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.users
                    && wellFormedPair(request.resource.data)
                    && request.resource.data.initiatedBy in request.resource.data.users
                    && request.resource.data.initiatedBy != request.auth.uid;

      // Friendships are not edited. Either you are friends or you are not.
      allow update: if false;

      // Either party can unfriend, and doing so removes it for both, which is
      // the honest behaviour for a single shared document.
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.users;
    }

    // =========================================================================
    // INVITES COLLECTION (Wave B)
    // =========================================================================
    // Keyed BY the invite code so redeeming one is a direct get. A query
    // cannot be authorised per-document; a get can.
    //
    // Read is open to any signed-in user because redeeming requires reading a
    // code you were given. The document deliberately carries no personal data,
    // only the creator's uid and the status, so an enumerated code leaks
    // nothing beyond the existence of an invite.

    match /invites/{code} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.code == code
                    && request.resource.data.status == 'pending'
                    && !('acceptedBy' in request.resource.data);

      // Exactly two transitions are allowed from a client.
      //
      // Accepting: anyone signed in who is NOT the creator may flip a pending,
      // unexpired invite to accepted, stamping themselves as the acceptor.
      // Everything else on the document must stay as it was, so an acceptor
      // cannot rewrite who created it or when it expires.
      // Parenthesised rather than leaning on && binding tighter than ||. A
      // security rule should not depend on the reader knowing the precedence
      // table.
      function isAcceptance() {
        return resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.auth.uid != resource.data.createdBy
            && request.resource.data.acceptedBy == request.auth.uid
            && request.time < resource.data.expiresAt
            && unchanged('code')
            && unchanged('createdBy')
            && unchanged('createdAt')
            && unchanged('expiresAt');
      }

      /** The creator withdrawing an invite nobody has taken yet. */
      function isRevocation() {
        return resource.data.status == 'pending'
            && request.resource.data.status == 'revoked'
            && request.auth.uid == resource.data.createdBy
            && unchanged('code')
            && unchanged('createdBy')
            && unchanged('createdAt')
            && unchanged('expiresAt');
      }

      allow update: if isAuthenticated() && (isAcceptance() || isRevocation());

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    // =========================================================================
    // TRIP SEGMENTS COLLECTION
    // =========================================================================

    match /tripSegments/{tripId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // =========================================================================
    // TRIP AI INSIGHTS COLLECTION
    // =========================================================================

    match /tripAiInsights/{tripId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // =========================================================================
    // AI USAGE TRACKING (admin/analytics only)
    // =========================================================================

    match /aiUsageTracking/{docId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COUNTERS (sharded counters, Cloud Functions only)
    // =========================================================================

    match /counters/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // =========================================================================
    // FEEDBACK COLLECTION
    // =========================================================================
    // Authenticated users can submit feedback; no client reads (admin SDK only).

    match /feedback/{docId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // =========================================================================
    // AI FEEDBACK EVENTS (client-side analytics, authenticated create only)
    // =========================================================================

    match /ai_feedback_events/{docId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // =========================================================================
    // MARKETING WAITLIST (authenticated create only, no client reads)
    // =========================================================================
    // Shared with the marketing site's serverless waitlist endpoint, which
    // writes through the Admin SDK and so bypasses these rules. The mobile
    // onboarding quote screen writes here directly, so its create path needs
    // an explicit rule. Reads stay closed: the public count is served by
    // apps/marketing's waitlist-count endpoint, not by client queries.

    match /marketing_waitlist/{docId} {
      allow create: if isAuthenticated()
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.source is string;
      allow read, update, delete: if false;
    }

    // =========================================================================
    // SYSTEM LOGS (admin SDK only, FCA audit trail)
    // =========================================================================

    match /systemLogs/{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // CATCH-ALL: DENY
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
