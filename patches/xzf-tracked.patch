+
+// ============================================================================
+// QUOTES COLLECTION (Root Platform Integration)
+// ============================================================================
+
+export type QuoteStatus = 'pending' | 'active' | 'expired' | 'converted' | 'declined';
+
+/**
+ * Extended user profile for Root API
+ * Additional fields required for insurance quotes
+ */
+export interface ExtendedUserProfile {
+  firstName: string;
+  lastName: string;
+  dateOfBirth: string;          // ISO 8601 date
+  idNumber: string;             // SA ID number (13 digits)
+  postalCode: string;
+}
+
+/**
+ * Vehicle info for Root API (extended)
+ */
+export interface QuoteVehicleInfo {
+  make: string;
+  model: string;
+  year: number;
+  registration: string;
+  vin?: string;
+}
+
+/**
+ * Telematics data formatted for Root API
+ */
+export interface RootTelematicsData {
+  overall_score: number;
+  trip_count: number;
+  total_distance_km: number;
+  avg_speed_kph: number;
+  recent_trips: RootTripSummary[];
+}
+
+export interface RootTripSummary {
+  date: string;                 // ISO 8601
+  distance_km: number;
+  duration_seconds: number;
+  score: number;
+  harsh_braking_events: number;
+  speeding_events: number;
+}
+
+/**
+ * Root API Request Body
+ */
+export interface RootQuoteRequest {
+  type: string;                 // "root_insurance_za.car.comprehensive"
+  policyholder: {
+    id: string;
+    first_name: string;
+    last_name: string;
+    email: string;
+    date_of_birth: string;
+    id_number: string;
+  };
+  vehicle: {
+    make: string;
+    model: string;
+    year: number;
+    registration: string;
+  };
+  telematics: RootTelematicsData;
+  billing_amount: {
+    currency: string;
+    amount: number;
+  };
+}
+
+/**
+ * Root API Response
+ */
+export interface RootQuoteResponse {
+  quote_package_id: string;
+  package_name: string;
+  sum_assured: number;
+  base_premium: number;           // In cents
+  monthly_premium: number;        // In cents
+  suggested_premium: number;      // In cents, with telematics discount
+  created_at: string;             // ISO 8601
+}
+
+/**
+ * Transformed quote for Driiva
+ */
+export interface DrivaQuote {
+  quoteId: string;
+  basePremiumZAR: number;         // In ZAR (converted from cents)
+  telematicsDiscountZAR: number;
+  finalPremiumZAR: number;
+  monthlyPremiumZAR: number;
+  currency: 'ZAR';
+  validUntil: Date;
+  provider: 'Root';
+  isMockQuote: boolean;
+}
+
+/**
+ * Quote document stored in Firestore
+ * Collection: quotes/{quoteId}
+ */
+export interface QuoteDocument {
+  quoteId: string;
+  userId: string;
+  
+  // Root API Reference
+  rootQuotePackageId: string | null;
+  rootPackageName: string | null;
+  
+  // Financial (all in cents for precision)
+  basePremiumCents: number;
+  telematicsDiscountCents: number;
+  finalPremiumCents: number;
+  monthlyPremiumCents: number;
+  sumAssuredCents: number;
+  currency: 'ZAR';
+  
+  // Telematics snapshot at quote time
+  telematicsSnapshot: {
+    overallScore: number;
+    tripCount: number;
+    totalDistanceKm: number;
+    avgSpeedKph: number;
+  };
+  
+  // Vehicle at quote time
+  vehicle: QuoteVehicleInfo;
+  
+  // Status
+  status: QuoteStatus;
+  isMockQuote: boolean;           // True if Root API was unavailable
+  
+  // Timestamps
+  createdAt: Timestamp;
+  validUntil: Timestamp;
+  convertedAt: Timestamp | null;  // When converted to policy
+  
+  // Audit
+  createdBy: string;
+  updatedBy: string;
+  updatedAt: Timestamp;
+}
