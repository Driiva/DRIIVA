diff --git a/firestore.rules b/firestore.rules
index eb744e5..404596c 100644
--- a/firestore.rules
+++ b/firestore.rules
@@ -181,6 +181,24 @@ service cloud.firestore {
       allow write: if false;
     }
     
+    // =========================================================================
+    // QUOTES COLLECTION
+    // =========================================================================
+    
+    match /quotes/{quoteId} {
+      // Users can read their own quotes
+      allow read: if isAuthenticated()
+        && resource.data.userId == request.auth.uid;
+      
+      // Only Cloud Functions (admin SDK) can create/update quotes
+      // Quotes are generated server-side via Root Platform API
+      allow create: if false;
+      allow update: if false;
+      
+      // Quotes cannot be deleted
+      allow delete: if false;
+    }
+    
     // =========================================================================
     // CATCH-ALL: DENY EVERYTHING ELSE
     // =========================================================================
