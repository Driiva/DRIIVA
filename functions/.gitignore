# Compiled JavaScript (lib/) is gitignored at the repo root (M1 T7) - it is a
# build artifact regenerated by firebase.json's functions.predeploy hook
# (`npm run build`) before every deploy, so committing it was redundant and
# let stale/pre-existing source issues (e.g. dash-rule violations) leak into
# the tracked tree. If a real deploy ever fails with "entry point not found",
# check first whether Firebase's source-packaging step is excluding lib/ via
# this ignore rule before assuming the predeploy build itself failed.

# Node modules
node_modules/

# Local env files (keep .env.example for documentation)
*.local
.env
!.env.example

# Debug logs
firebase-debug.log
firebase-debug.*.log

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db
