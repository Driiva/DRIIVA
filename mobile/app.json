{
  "expo": {
    "name": "Driiva",
    "slug": "driiva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "driiva",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.driiva.app",
      "googleServicesFile": "$GOOGLE_SERVICES_PLIST",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Driiva uses your location to track trips and calculate your driving safety score.",
        "NSLocationWhenInUseUsageDescription": "Driiva uses your location to track trips and calculate your driving safety score.",
        "NSMotionUsageDescription": "Driiva uses motion sensors to detect phone usage while driving.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "backgroundColor": "#0a0a14"
      },
      "package": "com.driiva.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBFirestore",
              "RNFBMessaging"
            ]
          }
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Driiva uses your location to track trips and calculate your driving safety score.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@react-native-firebase/app",
      "./plugins/with-firebase-configure"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2678b4d2-f201-4ffa-8bbf-65c89d813746"
      }
    },
    "owner": "mrshippers"
  }
}
