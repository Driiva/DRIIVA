{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["node"],
    "noEmit": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "allowImportingTsExtensions": false,
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["src/__tests__/**", "node_modules", "dist"]
}
